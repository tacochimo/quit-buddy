# Supabase project settings: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose. Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled connection string from Supabase → Connect → Transaction pooler
# Required for Drizzle on Vercel serverless. Use port 6543 (pgbouncer), not 5432.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Public site URL — used for auth redirects. Set to your Vercel URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OpenAI for the AI coach (server-only). Optional: defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-user daily message cap for the coach. Default 30. Resets at UTC midnight.
COACH_DAILY_LIMIT=30
# Per-user monthly $ budget for OpenAI calls. Default 0.50 (~5000 turns on
# gpt-4o-mini). Set to 0 to disable enforcement. Resets on the 1st UTC.
COACH_MONTHLY_BUDGET_USD=0.50

# Comma-separated emails that can view /app/admin/usage. Empty = nobody.
ADMIN_EMAILS=

# Vercel auto-generates CRON_SECRET when cron jobs are enabled; only set
# manually if you need to override (e.g., calling the cron endpoint from
# external systems).
CRON_SECRET=

#Vercel env vars:
#STRIPE_SECRET_KEY (test or live)
#STRIPE_WEBHOOK_SECRET (from the webhook endpoint you'll add next)
#STRIPE_PRICE_ID_PLUS_MONTHLY (the price ID from step 1)
#NEXT_PUBLIC_SITE_URL (e.g. https://your-app.vercel.app)



#PayPal env vars to add:

#PAYPAL_CLIENT_ID (server)
#NEXT_PUBLIC_PAYPAL_CLIENT_ID (same value, exposed to browser for the SDK)
#PAYPAL_CLIENT_SECRET
#PAYPAL_WEBHOOK_ID
#PAYPAL_PLAN_ID — the plan you create in PayPal dashboard for $4.99/mo
#NEXT_PUBLIC_PAYPAL_PLAN_ID (same value, exposed to browser)
#PAYPAL_ENV — sandbox or live

#NEXT_PUBLIC_POSTHOG_KEY (project API key, public)
#NEXT_PUBLIC_POSTHOG_HOST (default https://us.i.posthog.com or https://eu.i.posthog.com)
#POSTHOG_PROJECT_API_KEY (same as public — PostHog uses one key)